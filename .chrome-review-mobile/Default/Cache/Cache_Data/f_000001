}

.landing-root
  .landing-hero__install
  .landing-hero__copy-button.is-copied
  .landing-hero__copy-icon:not(.landing-hero__copy-icon--success) {
  opacity: 0;
  visibility: hidden;
}

.landing-root
  .landing-hero__install
  .landing-hero__copy-button.is-copied
  .landing-hero__copy-icon--success {
