.landing-navbar-shell {
  position: sticky;
  top: 0;
  z-index: 40;
  padding-top: 0.75rem;
}

.landing-navbar {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 1rem;
  min-height: 3.75rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--landing-border);
