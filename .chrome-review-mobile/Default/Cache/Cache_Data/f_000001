.landing-touch-surfaces {
  padding-top: clamp(1.5rem, 3vw, 2.5rem);
}

.landing-touch-surfaces__proof {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  width: 100%;
  margin-top: 0;
  overflow: hidden;
