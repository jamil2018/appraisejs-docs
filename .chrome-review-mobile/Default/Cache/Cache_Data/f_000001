  border: 1px solid var(--landing-border);
  border-radius: var(--landing-radius);
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.2;
  transition:
    background-color 160ms ease,
    border-color 160ms ease,
    color 160ms ease,
    transform 160ms ease;
}

.landing-cta-button {
