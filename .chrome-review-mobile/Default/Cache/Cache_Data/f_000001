  color: var(--landing-text);
  line-height: 0;
  appearance: none;
}

.landing-navbar__hamburger :is(svg) {
  grid-area: 1 / 1;
  display: block;
  width: 1rem;
  height: 1rem;
  margin: 0;
  transform-origin: center;
  transition:
    opacity 160ms ease,
    transform 160ms ease,
    visibility 0s linear;
}

.landing-navbar__hamburger .landing-navbar__menu-icon {
  opacity: 1;
  visibility: visible;
  transform: rotate(0deg) scale(1);
}

.landing-navbar.is-open .landing-navbar__hamburger .landing-navbar__close-icon {
  opacity: 1;
  visibility: visible;
  transform: rotate(0deg) scale(1);
}

.landing-navbar__hamburger .landing-navbar__close-icon {
  opacity: 0;
  visibility: hidden;
  transform: rotate(-90deg) scale(0.75);
}

.landing-navbar.is-open .landing-navbar__hamburger .landing-navbar__menu-icon {
  opacity: 0;
  visibility: hidden;
  transform: rotate(90deg) scale(0.75);
}

.landing-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: clamp(2rem, 4vw, 3.75rem);
