.landing-root .landing-hero__install .landing-hero__copy-button {
  display: grid;
  place-items: center;
  align-self: stretch;
  width: 100%;
  height: 100%;
  min-height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-left: 1px solid var(--landing-border);
  border-radius: 0;
  background: transparent;
  color: var(--landing-muted);
