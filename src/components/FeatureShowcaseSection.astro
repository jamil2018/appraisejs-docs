---
import {
  Blocks,
  Crosshair,
  FileCode2,
  LayoutGrid,
  TerminalSquare,
} from "@lucide/astro";
import AllInOneWorkspaceDemo from "./AllInOneWorkspaceDemo.astro";
import LocatorCreatorDemo from "./LocatorCreatorDemo.astro";
import PortableOutputDemo from "./PortableOutputDemo.astro";
import LocalFirstDemo from "./LocalFirstDemo.astro";
import DynamicIntegratorDemo from "./DynamicIntegratorDemo.astro";

const showcaseFeatures = [
  {
    id: "all-in-one",
    title: "All-in-One Workspace",
    description: "Design, run, and analyze your browser tests in one unified visual environment.",
    icon: LayoutGrid,
  },
  {
    id: "locator-creator",
    title: "Visual Locator Creator",
    description: "Point, click, and map robust selectors directly from your live application.",
    icon: Crosshair,
  },
  {
    id: "portable-output",
    title: "Portable Gherkin & Code",
    description: "Export clean, version-controlled Gherkin feature files and Playwright steps.",
    icon: FileCode2,
  },
  {
    id: "local-first",
    title: "Local-First Speed",
    description: "Execute tests instantly on your local machine with zero cloud latency.",
    icon: TerminalSquare,
  },
  {
    id: "dynamic-integrator",
    title: "Dynamic Step Integrator",
    description: "Extend your test suite with custom TypeScript steps in just a few seconds.",
    icon: Blocks,
  },
];
---

<section
  class="feature-showcase landing-shell"
  id="features-showcase"
  aria-labelledby="feature-showcase-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">Visual Power, Developer Rigor</p>
    <h2 id="feature-showcase-heading" class="landing-section-title">
      A visual IDE built for the modern testing loop.
    </h2>
    <p class="landing-section-description">
      AppraiseJS brings visual design and code-level precision together. Click through the live interactive previews below to explore the core capabilities of the visual editor.
    </p>
  </div>

  <div class="showcase-grid not-content" data-feature-showcase>
    <div class="showcase-tabs" role="tablist" aria-label="Feature showcase tabs">
      {
        showcaseFeatures.map((feature, index) => {
          const Icon = feature.icon;
          return (
            <button
              id={`showcase-tab-${feature.id}`}
              type="button"
              role="tab"
              class:list={["showcase-tab", index === 0 && "is-active"]}
              data-showcase-tab={feature.id}
              aria-controls={`showcase-panel-${feature.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
            >
              <span class="showcase-tab__icon" aria-hidden="true">
                <Icon size={20} stroke-width={1.8} />
              </span>
              <span class="showcase-tab__content">
                <strong class="showcase-tab__title">{feature.title}</strong>
                <span class="showcase-tab__description">{feature.description}</span>
              </span>
            </button>
          );
        })
      }
    </div>

    <div class="showcase-display">
      <div class="showcase-display__glow" aria-hidden="true"></div>
      
      <div
        id="showcase-panel-all-in-one"
        class="showcase-panel is-active"
        data-showcase-panel="all-in-one"
        role="tabpanel"
        aria-labelledby="showcase-tab-all-in-one"
      >
        <div class="showcase-panel__demo-wrapper is-active" data-feature-panel="all-in-one">
          <AllInOneWorkspaceDemo fill={true} />
        </div>
      </div>

      <div
        id="showcase-panel-locator-creator"
        class="showcase-panel"
        data-showcase-panel="locator-creator"
        role="tabpanel"
        aria-labelledby="showcase-tab-locator-creator"
      >
        <div class="showcase-panel__demo-wrapper" data-feature-panel="locator-creator">
          <LocatorCreatorDemo fill={true} />
        </div>
      </div>

      <div
        id="showcase-panel-portable-output"
        class="showcase-panel"
        data-showcase-panel="portable-output"
        role="tabpanel"
        aria-labelledby="showcase-tab-portable-output"
      >
        <div class="showcase-panel__demo-wrapper" data-feature-panel="portable-output">
          <PortableOutputDemo fill={true} />
        </div>
      </div>

      <div
        id="showcase-panel-local-first"
        class="showcase-panel"
        data-showcase-panel="local-first"
        role="tabpanel"
        aria-labelledby="showcase-tab-local-first"
      >
        <div class="showcase-panel__demo-wrapper" data-feature-panel="local-first">
          <LocalFirstDemo fill={true} />
        </div>
      </div>

      <div
        id="showcase-panel-dynamic-integrator"
        class="showcase-panel"
        data-showcase-panel="dynamic-integrator"
        role="tabpanel"
        aria-labelledby="showcase-tab-dynamic-integrator"
      >
        <div class="showcase-panel__demo-wrapper" data-feature-panel="dynamic-integrator">
          <DynamicIntegratorDemo fill={true} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-showcase {
    padding-top: clamp(4rem, 8vw, 8rem);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-top: 2.5rem;
  }

  .showcase-tabs {
    display: grid;
    gap: 0.75rem;
  }

  .showcase-tab {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.25rem;
    border: 1px solid var(--landing-border-soft);
    border-radius: var(--landing-radius);
    background: rgba(19, 19, 19, 0.4);
    color: var(--landing-muted);
    text-align: left;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
    cursor: pointer;
    appearance: none;
  }

  .showcase-tab:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--landing-text);
  }

  .showcase-tab.is-active {
    background: rgba(16, 185, 129, 0.06);
    border-color: rgba(16, 185, 129, 0.4);
    color: var(--landing-text);
    box-shadow: 
      0 4px 20px rgba(16, 185, 129, 0.04),
      inset 0 0 12px rgba(16, 185, 129, 0.02);
    transform: translateX(4px);
  }

  .showcase-tab__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--landing-border);
    border-radius: var(--landing-radius);
    background: #101010;
    color: var(--landing-dim);
    transition:
      border-color 200ms ease,
      color 200ms ease,
      background-color 200ms ease;
  }

  .showcase-tab:hover .showcase-tab__icon {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--landing-text);
  }

  .showcase-tab.is-active .showcase-tab__icon {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.12);
    color: var(--landing-green);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.1);
  }

  .showcase-tab__content {
    display: grid;
    gap: 0.35rem;
  }

  .showcase-tab__title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .showcase-tab__description {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--landing-dim);
    transition: color 200ms ease;
  }

  .showcase-tab:hover .showcase-tab__description {
    color: var(--landing-muted);
  }

  .showcase-tab.is-active .showcase-tab__description {
    color: rgba(255, 255, 255, 0.8);
  }

  .showcase-display {
    position: relative;
    display: grid;
    border: 1px solid var(--landing-border);
    border-radius: var(--landing-radius);
    background: #101010;
    min-height: clamp(24rem, 50vh, 32rem);
    overflow: hidden;
    box-shadow: 
      0 20px 50px rgba(0, 0, 0, 0.3),
      inset 0 0 40px rgba(255, 255, 255, 0.01);
  }

  .showcase-panel:not(.is-active) *,
  .showcase-panel:not(.is-active) *::before,
  .showcase-panel:not(.is-active) *::after {
    animation-play-state: paused !important;
  }

  .showcase-display__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, rgba(16, 185, 129, 0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 1;
  }

  .showcase-panel {
    display: none;
    grid-area: 1 / 1;
    width: 100%;
    min-height: clamp(24rem, 50vh, 32rem);
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .showcase-panel.is-active {
    display: block;
    opacity: 1;
    transform: scale(1);
    z-index: 2;
  }

  .showcase-panel__demo-wrapper {
    width: 100%;
    height: 100%;
    min-height: inherit;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }

  .showcase-panel__demo-wrapper :global(.all-in-one-demo--fill),
  .showcase-panel__demo-wrapper :global(.locator-creator-demo--fill),
  .showcase-panel__demo-wrapper :global(.dynamic-integrator-demo--fill),
  .showcase-panel__demo-wrapper :global(.portable-output-demo--fill),
  .showcase-panel__demo-wrapper :global(.local-first-demo--fill) {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    max-height: 100%;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .showcase-panel__demo-wrapper :global(.all-in-one-demo--fill .all-in-one-demo__panel),
  .showcase-panel__demo-wrapper :global(.locator-creator-demo--fill .locator-creator-demo__panel),
  .showcase-panel__demo-wrapper :global(.dynamic-integrator-demo--fill .dynamic-integrator-demo__panel),
  .showcase-panel__demo-wrapper :global(.portable-output-demo--fill .portable-output-demo__panel) {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .showcase-panel__demo-wrapper :global(.local-first-demo--fill .local-first-demo__stage),
  .showcase-panel__demo-wrapper :global(.dynamic-integrator-demo--fill .dynamic-integrator-demo__stage),
  .showcase-panel__demo-wrapper :global(.portable-output-demo--fill .portable-output-demo__stage) {
    width: 100%;
    max-width: none;
    height: 100%;
    min-height: 0;
    margin: 0;
  }

  .showcase-panel__demo-wrapper :global(.locator-creator-demo--fill .locator-creator-demo__canvas) {
    min-height: 12rem;
  }

  @media (max-width: 1024px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .showcase-tab.is-active {
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .showcase-tab {
      padding: 1rem;
      gap: 0.75rem;
    }

    .showcase-tab__icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .showcase-display {
      min-height: clamp(18rem, 40vh, 24rem);
    }
  }
</style>

<script>
  function initFeatureShowcase() {
    const showcaseContainers = document.querySelectorAll("[data-feature-showcase]");

    showcaseContainers.forEach((container) => {
      const tabs = Array.from(container.querySelectorAll("[data-showcase-tab]")) as HTMLElement[];
      const panels = Array.from(container.querySelectorAll("[data-showcase-panel]")) as HTMLElement[];

      if (tabs.length === 0 || panels.length === 0) return;

      const activate = (id: string) => {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.showcaseTab === id;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
          tab.setAttribute("tabindex", isActive ? "0" : "-1");
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.showcasePanel === id;
          const featurePanel = panel.querySelector(
            "[data-feature-panel]",
          ) as HTMLElement | null;

          if (isActive) {
            panel.style.display = "block";
            // Force reflow to trigger animation
            void panel.offsetWidth;
            panel.classList.add("is-active");
            featurePanel?.classList.add("is-active");
          } else {
            panel.classList.remove("is-active");
            featurePanel?.classList.remove("is-active");
            // Wait for transition to end before hiding
            setTimeout(() => {
              if (!panel.classList.contains("is-active")) {
                panel.style.display = "none";
              }
            }, 300);
          }
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          const id = tab.dataset.showcaseTab;
          if (id) activate(id);
        });

        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
          event.preventDefault();
          const direction = event.key === "ArrowDown" ? 1 : -1;
          const nextTab = tabs[(index + direction + tabs.length) % tabs.length];
          nextTab?.focus();
          const id = nextTab?.dataset.showcaseTab;
          if (id) activate(id);
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initFeatureShowcase);
  initFeatureShowcase();
</script>
