---
import {
  ArrowDown,
  ArrowRight,
  CheckCircle2,
  Code2,
  FileCode2,
  FileJson2,
  FolderGit2,
  GitPullRequestArrow,
} from "@lucide/astro";

const codeMapRows = [
  {
    source: { type: "Flow", label: "Login success path" },
    output: { type: "login.feature", label: "Readable scenario" },
  },
  {
    source: { type: "Locator", label: "button: Sign in" },
    output: { type: "auth.locators.json", label: "Route-aware selector" },
  },
  {
    source: { type: "Helper step", label: "fill credentials" },
    output: { type: "auth.step.ts", label: "Step definition" },
  },
  {
    source: { type: "Run", label: "Auth smoke / Chromium" },
    output: { type: "report.json", label: "Execution evidence" },
  },
];
---

<section
  class="code-map landing-shell"
  id="generated-output"
  aria-labelledby="code-map-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">Generated output</p>
    <h2 id="code-map-heading" class="landing-section-title">
      What the visual flow actually generates.
    </h2>
    <p class="landing-section-description">
      The visual editor is only the authoring layer. The evaluation path is a
      local project with reviewable repo files: scenarios, step definitions,
      locator maps, and run evidence.
    </p>
  </div>

  <div class="proof-stage">
    <div class="code-map__grid">
      <article class="code-map__panel">
        <div class="landing-panel__bar">
          <span>visual workflow</span>
          <span>source</span>
        </div>
        <ul>
          {
            codeMapRows.map((row) => (
              <li>
                <span>{row.source.type}</span>
                <strong>{row.source.label}</strong>
              </li>
            ))
          }
        </ul>
      </article>

      <div class="code-map__bridges" aria-hidden="true">
        <div class="landing-panel__bar code-map__bridges-bar">
          <span>&nbsp;</span>
        </div>
        <div class="code-map__bridge-list">
          {
            codeMapRows.map(() => (
              <div class="code-map__bridge">
                <ArrowRight size={14} stroke-width={2} />
              </div>
            ))
          }
        </div>
      </div>

      <article class="code-map__panel code-map__panel--output">
        <div class="landing-panel__bar">
          <span>repository output</span>
          <span>generated</span>
        </div>
        <ul>
          {
            codeMapRows.map((row) => (
              <li>
                <span>{row.output.type}</span>
                <strong>{row.output.label}</strong>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <ul
      class="code-map__mobile-list"
      aria-label="Visual workflow to repository output"
    >
      {
        codeMapRows.map((row) => (
          <li class="code-map__mobile-row">
            <div class="code-map__mobile-cell">
              <span>{row.source.type}</span>
              <strong>{row.source.label}</strong>
            </div>
            <div class="code-map__mobile-arrow" aria-hidden="true">
              <ArrowDown size={16} stroke-width={2} />
            </div>
            <div class="code-map__mobile-cell code-map__mobile-cell--output">
              <span>{row.output.type}</span>
              <strong>{row.output.label}</strong>
            </div>
          </li>
        ))
      }
    </ul>

    <article
      class="artifact-preview"
      aria-labelledby="artifact-preview-heading"
    >
      <div class="landing-panel__bar">
        <span>reviewable repo files</span>
        <span>generated</span>
      </div>
      <div class="artifact-preview__body">
        <div class="artifact-preview__intro">
          <h3 id="artifact-preview-heading">What lands in the repo</h3>
          <p>
            A visual login flow still resolves to explicit scenario text,
            reusable step definitions, locator data, and run evidence.
          </p>
          <ul class="artifact-file-tree" aria-label="Generated file tree">
            <li><FolderGit2 aria-hidden="true" /> tests/generated/</li>
            <li><FileCode2 aria-hidden="true" /> login.feature</li>
            <li><Code2 aria-hidden="true" /> auth.step.ts</li>
            <li><FileJson2 aria-hidden="true" /> auth.locators.json</li>
            <li><FileJson2 aria-hidden="true" /> report.json</li>
          </ul>
        </div>
        <div class="artifact-preview__snippets">
          <pre><code><span class="token-key">Feature:</span> Authentication smoke
  <span class="token-key">Scenario:</span> Login with valid credentials
    <span class="token-key">When</span> I fill "email" with test user
    <span class="token-key">And</span> I click "Sign in"
    <span class="token-key">Then</span> "welcomeBanner" should be visible</code></pre>
          <pre><code><span class="token-key">When</span>(<span class="token-string">"I click &#123;string&#125;"</span>, async (&#123; page &#125;, name) => &#123;
  const target = locators[name];
  await page.locator(target.selector).click();
&#125;);</code></pre>
        </div>
      </div>
    </article>
  </div>

  <div
    class="positioning-grid"
    aria-label="Why AppraiseJS fits engineering teams"
  >
    <article>
      <CheckCircle2 aria-hidden="true" />
      <h3>QA authors model flows</h3>
      <p>
        Browser journeys start as visual steps, locators, and assertions before
        they become automation.
      </p>
    </article>
    <article>
      <Code2 aria-hidden="true" />
      <h3>Engineers review generated code</h3>
      <p>
        The output lands as repo-owned Playwright/Cucumber files instead of
        trapped recorder scripts.
      </p>
    </article>
    <article>
      <GitPullRequestArrow aria-hidden="true" />
      <h3>CI runs normal automation</h3>
      <p>
        Run locally first, then carry the same generated artifacts into your
        existing CI loop.
      </p>
    </article>
  </div>

  <div class="section-cta">
    <a class="landing-secondary-button" href="/getting-started/quick-start/">
      Run the quick start and inspect these files
    </a>
  </div>
</section>
