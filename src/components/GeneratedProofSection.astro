---
import {
  ArrowDown,
  ArrowRight,
  CheckCircle2,
  Code2,
  ExternalLink,
  FileCode2,
  FileJson2,
  FolderGit2,
  GitPullRequestArrow,
  ListChecks,
  TerminalSquare,
} from "@lucide/astro";

const codeMapRows = [
  {
    source: { type: "Visual flow", label: "Checkout smoke path" },
    output: {
      type: "features/checkout-smoke.feature",
      label: "Readable Gherkin scenario",
    },
  },
  {
    source: {
      type: "Locator capture",
      label: "Cart, email, payment selectors",
    },
    output: {
      type: "locators/checkout.locators.json",
      label: "Repo-owned selector map",
    },
  },
  {
    source: { type: "Reusable action", label: "Sign in and complete purchase" },
    output: {
      type: "steps/checkout.steps.ts",
      label: "Playwright step definitions",
    },
  },
  {
    source: { type: "Local run", label: "Chromium smoke execution" },
    output: {
      type: "reports/checkout-smoke/report.json",
      label: "Run, timing, and debug evidence",
    },
  },
];

const artifactFiles = [
  {
    icon: FileCode2,
    path: "tests/appraise/features/checkout-smoke.feature",
  },
  {
    icon: Code2,
    path: "tests/appraise/steps/checkout.steps.ts",
  },
  {
    icon: FileJson2,
    path: "tests/appraise/locators/checkout.locators.json",
  },
  {
    icon: FileJson2,
    path: "test-results/appraise/checkout-smoke/report.json",
  },
  {
    icon: FileJson2,
    path: "test-results/appraise/checkout-smoke/run-evidence.json",
  },
];

const docsLinks = [
  {
    href: "/getting-started/creating-tests/",
    label: "Creating tests",
    description: "How visual flows become saved test cases.",
  },
  {
    href: "/run-and-analyze/reports/",
    label: "Reports",
    description: "Where local run evidence and report data live.",
  },
  {
    href: "/reference/architecture/execution-lifecycle/",
    label: "Execution lifecycle",
    description: "How generated files move through a run.",
  },
  {
    href: "/reference/architecture/synchronization-pipeline/",
    label: "Sync behavior",
    description: "How project data and generated artifacts stay aligned.",
  },
];

const inspectionItems = [
  "Can engineers read and review the generated Gherkin and step code?",
  "Does locator ownership stay explicit enough for your app?",
  "Can the generated Playwright run in your existing CI shape?",
  "Do reports expose enough evidence for failed-run debugging?",
  "Does sync behavior match how your team maintains tests in git?",
];
---

<section
  class="code-map landing-shell"
  id="generated-output"
  aria-labelledby="code-map-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">Generated sample</p>
    <h2 id="code-map-heading" class="landing-section-title">
      Inspect the repo output before you install anything.
    </h2>
    <p class="landing-section-description">
      AppraiseJS is easiest to evaluate by looking at the files it would put in
      your project. This static sample shows the shape of a realistic checkout
      smoke flow: Gherkin, Playwright steps, locator data, and run evidence.
    </p>
  </div>

  <div class="proof-stage">
    <div class="code-map__grid">
      <article class="code-map__panel">
        <div class="landing-panel__bar">
          <span>visual authoring</span>
          <span>source</span>
        </div>
        <ul>
          {
            codeMapRows.map((row) => (
              <li>
                <span>{row.source.type}</span>
                <strong>{row.source.label}</strong>
              </li>
            ))
          }
        </ul>
      </article>

      <div class="code-map__bridges" aria-hidden="true">
        <div class="landing-panel__bar code-map__bridges-bar">
          <span>&nbsp;</span>
        </div>
        <div class="code-map__bridge-list">
          {
            codeMapRows.map(() => (
              <div class="code-map__bridge">
                <ArrowRight size={14} stroke-width={2} />
              </div>
            ))
          }
        </div>
      </div>

      <article class="code-map__panel code-map__panel--output">
        <div class="landing-panel__bar">
          <span>repository output</span>
          <span>generated</span>
        </div>
        <ul>
          {
            codeMapRows.map((row) => (
              <li>
                <span>{row.output.type}</span>
                <strong>{row.output.label}</strong>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <ul
      class="code-map__mobile-list"
      aria-label="Visual workflow to repository output"
    >
      {
        codeMapRows.map((row) => (
          <li class="code-map__mobile-row">
            <div class="code-map__mobile-cell">
              <span>{row.source.type}</span>
              <strong>{row.source.label}</strong>
            </div>
            <div class="code-map__mobile-arrow" aria-hidden="true">
              <ArrowDown size={16} stroke-width={2} />
            </div>
            <div class="code-map__mobile-cell code-map__mobile-cell--output">
              <span>{row.output.type}</span>
              <strong>{row.output.label}</strong>
            </div>
          </li>
        ))
      }
    </ul>

    <article
      class="artifact-preview artifact-preview--sample"
      aria-labelledby="artifact-preview-heading"
    >
      <div class="landing-panel__bar">
        <span>sample repo output</span>
        <span>static proof</span>
      </div>
      <div class="artifact-preview__body">
        <div class="artifact-preview__intro">
          <h3 id="artifact-preview-heading">What lands in the repo</h3>
          <p>
            The visual flow becomes normal project files. Treat this as an
            adoption review: read the scenario, inspect selectors, and check
            whether the run evidence is enough for your debugging loop.
          </p>
          <ul
            class="artifact-file-tree"
            aria-label="Sample generated file tree"
          >
            <li><FolderGit2 aria-hidden="true" /> appraisejs-sample/</li>
            {
              artifactFiles.map((file) => {
                const Icon = file.icon;
                return (
                  <li>
                    <Icon aria-hidden="true" />
                    {file.path}
                  </li>
                );
              })
            }
          </ul>
        </div>
        <div class="artifact-preview__snippets">
          <pre><code><span class="token-comment"># tests/appraise/features/checkout-smoke.feature</span>
<span class="token-key">Feature:</span> Checkout smoke
  <span class="token-key">Background:</span>
    <span class="token-key">Given</span> I open the storefront
    <span class="token-key">And</span> I sign in as "returning_buyer"

  <span class="token-key">Scenario:</span> Returning buyer completes a card checkout
    <span class="token-key">When</span> I add "Everyday Hoodie" to the cart
    <span class="token-key">And</span> I use the saved shipping address
    <span class="token-key">And</span> I pay with "visa_success"
    <span class="token-key">Then</span> the order confirmation should be visible
    <span class="token-key">And</span> the confirmation total should equal "$64.00"</code></pre>
          <pre><code><span class="token-comment">// tests/appraise/steps/checkout.steps.ts</span>
<span class="token-key">import</span> &#123; expect &#125; <span class="token-key">from</span> <span class="token-string">"@playwright/test"</span>;
<span class="token-key">import</span> locators <span class="token-key">from</span> <span class="token-string">"../locators/checkout.locators.json"</span>;

When(<span class="token-string">"I add &#123;string&#125; to the cart"</span>, async (&#123; page &#125;, itemName) =&gt; &#123;
  await page.getByRole(<span class="token-string">"link"</span>, &#123; name: itemName &#125;).click();
  await page.locator(locators.product.addToCart.selector).click();
  await expect(page.locator(locators.cart.summary.selector)).toBeVisible();
&#125;);

Then(<span class="token-string">"the confirmation total should equal &#123;string&#125;"</span>, async (&#123; page &#125;, total) =&gt; &#123;
  await expect(page.locator(locators.order.total.selector)).toHaveText(total);
&#125;);</code></pre>
          <pre><code><span class="token-comment">// tests/appraise/locators/checkout.locators.json</span>
&#123;
  <span class="token-string">"product.addToCart"</span>: &#123;
    <span class="token-string">"selector"</span>: <span class="token-string">"[data-testid='add-to-cart']"</span>,
    <span class="token-string">"owner"</span>: <span class="token-string">"checkout-flow"</span>,
    <span class="token-string">"fallback"</span>: <span class="token-string">"role=button[name='Add to cart']"</span>
  &#125;,
  <span class="token-string">"order.total"</span>: &#123;
    <span class="token-string">"selector"</span>: <span class="token-string">"[data-testid='confirmation-total']"</span>,
    <span class="token-string">"route"</span>: <span class="token-string">"/checkout/confirmation"</span>
  &#125;
&#125;</code></pre>
          <pre><code><span class="token-comment">// test-results/appraise/checkout-smoke/report.json</span>
&#123;
  <span class="token-string">"status"</span>: <span class="token-string">"passed"</span>,
  <span class="token-string">"browser"</span>: <span class="token-string">"chromium"</span>,
  <span class="token-string">"durationMs"</span>: 18420,
  <span class="token-string">"artifacts"</span>: [
    <span class="token-string">"trace.zip"</span>,
    <span class="token-string">"screenshots/order-confirmation.png"</span>,
    <span class="token-string">"run-evidence.json"</span>
  ]
&#125;</code></pre>
        </div>
      </div>
    </article>
  </div>

  <div class="proof-support-grid" aria-label="Generated output support">
    <article class="inspection-checklist">
      <div class="inspection-checklist__heading">
        <ListChecks aria-hidden="true" />
        <h3>What to inspect before adopting</h3>
      </div>
      <ul>
        {
          inspectionItems.map((item) => (
            <li>
              <CheckCircle2 aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <div class="proof-docs" aria-label="Relevant documentation">
      {
        docsLinks.map((link) => (
          <a href={link.href}>
            <ExternalLink aria-hidden="true" />
            <span>{link.label}</span>
            <strong>{link.description}</strong>
          </a>
        ))
      }
    </div>
  </div>

  <div
    class="positioning-grid"
    aria-label="Why AppraiseJS fits engineering teams"
  >
    <article>
      <CheckCircle2 aria-hidden="true" />
      <h3>QA authors model flows</h3>
      <p>
        Browser journeys start as visual steps, locators, and assertions before
        they become automation.
      </p>
    </article>
    <article>
      <Code2 aria-hidden="true" />
      <h3>Engineers review generated code</h3>
      <p>
        The output lands as repo-owned Playwright/Cucumber files instead of
        trapped recorder scripts.
      </p>
    </article>
    <article>
      <GitPullRequestArrow aria-hidden="true" />
      <h3>CI runs normal automation</h3>
      <p>
        Run locally first, then carry the same generated artifacts into your
        existing CI loop.
      </p>
    </article>
  </div>

  <div class="section-cta">
    <a class="landing-secondary-button" href="/getting-started/quick-start/">
      <TerminalSquare aria-hidden="true" />
      Run the quick start after inspection
    </a>
  </div>
</section>

<div class="mobile-sticky-cta" aria-label="Mobile quick actions">
  <a class="landing-cta-button" href="/getting-started/quick-start/">
    Run quick start
  </a>
  <a
    class="mobile-sticky-cta__github"
    href="https://github.com/jamil2018/appraisejs-core"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View GitHub repository"
  >
    <ExternalLink aria-hidden="true" />
  </a>
</div>
