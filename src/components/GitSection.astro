---
import {
  ArrowRight,
  BookOpen,
  ExternalLink,
  GitBranch,
  ShieldCheck,
} from "@lucide/astro";

const codeMapRows = [
  {
    source: { type: "Test Suite", label: "Validate Checkout" },
    output: { type: "Checkout.Feature", label: "Cucumber Feature" },
  },
  {
    source: { type: "Test Case", label: "Checkout With Valid Data" },
    output: { type: "Valid Checkout.Scenario", label: "Cucumber Scenario" },
  },
  {
    source: { type: "Locator", label: "button: Complete order" },
    output: { type: "checkout.json", label: "JSON Locator Entry" },
  },
  {
    source: { type: "Locator Group", label: "page: Checkout" },
    output: { type: "Checkout.json", label: "Creation of JSON Locator File" },
  },
  {
    source: { type: "Template Step Group", label: "Keyboard" },
    output: {
      type: "keyboard.step.ts",
      label: "Create step definition file",
    },
  },
  {
    source: { type: "Template Step", label: "Fill" },
    output: { type: "keyboard.step.ts", label: "Step definition function" },
  },
  {
    source: { type: "Reports", label: "Checkout Test Report" },
    output: { type: "report.json", label: "JSON Report Entry" },
  },
];
---

<section class="code-map landing-shell" aria-labelledby="code-map-heading">
  <div class="landing-section-copy">
    <p class="landing-kicker">Built around real automation</p>
    <h2 id="code-map-heading" class="landing-section-title">
      Every interaction generates physcial output that can be reviewed.
    </h2>
  </div>

  <div class="code-map__grid">
    <article class="code-map__panel">
      <div class="landing-panel__bar">
        <span>visual workflow</span>
        <span>source</span>
      </div>
      <ul>
        {
          codeMapRows.map((row) => (
            <li>
              <span>{row.source.type}</span>
              <strong>{row.source.label}</strong>
            </li>
          ))
        }
      </ul>
    </article>

    <div class="code-map__bridges" aria-hidden="true">
      <div class="landing-panel__bar code-map__bridges-bar">
        <span>&nbsp;</span>
      </div>
      <div class="code-map__bridge-list">
        {
          codeMapRows.map(() => (
            <div class="code-map__bridge">
              <ArrowRight size={14} stroke-width={2} />
            </div>
          ))
        }
      </div>
    </div>

    <article class="code-map__panel code-map__panel--output">
      <div class="landing-panel__bar">
        <span>repository output</span>
        <span>generated</span>
      </div>
      <ul>
        {
          codeMapRows.map((row) => (
            <li>
              <span>{row.output.type}</span>
              <strong>{row.output.label}</strong>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>

<section
  class="docs-preview landing-shell"
  aria-labelledby="docs-preview-heading"
>
  <div class="docs-preview__copy">
    <p class="landing-kicker">Documentation preview</p>
    <h2 id="docs-preview-heading" class="landing-section-title">
      Start from the workflow you need.
    </h2>
  </div>
  <div class="docs-preview__grid">
    <a href="/getting-started/quick-start/">
      <BookOpen aria-hidden="true" />
      <span>Quick Start</span>
      <strong>Install, model, run, and inspect your first flow.</strong>
    </a>
    <a href="/build-tests/locators/">
      <ShieldCheck aria-hidden="true" />
      <span>Locator Builder</span>
      <strong>Create locator groups that survive UI changes.</strong>
    </a>
    <a href="/reference/architecture/execution-lifecycle/">
      <GitBranch aria-hidden="true" />
      <span>Execution Lifecycle</span>
      <strong>Understand generated files, runs, logs, and reports.</strong>
    </a>
  </div>
</section>

<section
  class="open-source landing-shell"
  aria-labelledby="open-source-heading"
>
  <div class="open-source__copy">
    <p class="landing-kicker">Open source</p>
    <h2 id="open-source-heading" class="landing-section-title">
      No vendor lock-in. No hidden runner. No black boxes.
    </h2>
    <p class="landing-section-description">
      AppraiseJS is built around repositories, pull requests, and automation
      artifacts that remain useful outside the visual editor.
    </p>
  </div>
  <div class="open-source__actions">
    <a class="landing-cta-button" href="/getting-started/quick-start/">
      Quick Start
    </a>
    <a
      class="open-source__link"
      href="https://github.com/jamil2018/appraisejs-core"
      target="_blank"
      rel="noopener noreferrer"
    >
      <ExternalLink aria-hidden="true" />
      View GitHub Repository
    </a>
  </div>
</section>
