---
import {
  BookOpen,
  ExternalLink,
  FileCode2,
  GitBranch,
  GitPullRequestArrow,
  MonitorPlay,
  Scale,
  ShieldCheck,
} from "@lucide/astro";
---

<section
  class="engineer-trust landing-shell"
  aria-labelledby="engineer-trust-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">What engineers keep</p>
    <h2 id="engineer-trust-heading" class="landing-section-title">
      Visual authoring without giving up the engineering loop.
    </h2>
    <p class="landing-section-description">
      AppraiseJS should fit a serious test stack: generated artifacts stay
      portable, execution stays local-first, and the evaluation path starts with
      one real smoke test.
    </p>
  </div>

  <div class="engineer-trust__grid">
    <a href="/getting-started/creating-tests/">
      <FileCode2 aria-hidden="true" />
      <span>Real artifacts</span>
      <strong
        >Live Gherkin preview, generated step code, and locator data.</strong
      >
    </a>
    <a href="/getting-started/running-tests/">
      <MonitorPlay aria-hidden="true" />
      <span>Local execution</span>
      <strong
        >Run the smoke flow locally and inspect the report before scaling.</strong
      >
    </a>
    <a
      href="https://github.com/jamil2018/appraisejs-core"
      target="_blank"
      rel="noopener noreferrer"
    >
      <GitBranch aria-hidden="true" />
      <span>Open source</span>
      <strong>Review source before installing the local scaffold.</strong>
    </a>
  </div>

  <div
    class="engineering-loop-strip"
    aria-label="Built for existing engineering loops"
  >
    <span>Local project</span>
    <span>Git-reviewed files</span>
    <span>CI-compatible runs</span>
    <span>Open source core</span>
  </div>
</section>

<section
  class="comparison-block landing-shell"
  aria-labelledby="comparison-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">Why not just Playwright?</p>
    <h2 id="comparison-heading" class="landing-section-title">
      Keep Playwright as the engine. Add visual authoring where it helps.
    </h2>
    <p class="landing-section-description">
      AppraiseJS is not trying to hide automation from engineers. It gives QA
      and SDET teams a visual authoring path while keeping the output
      inspectable in the repo.
    </p>
  </div>

  <div class="comparison-grid">
    <article>
      <FileCode2 aria-hidden="true" />
      <h3>Playwright</h3>
      <p>
        Great execution engine. AppraiseJS adds visual flow authoring and
        generated artifacts that engineers can review.
      </p>
    </article>
    <article>
      <GitPullRequestArrow aria-hidden="true" />
      <h3>Cypress and recorders</h3>
      <p>
        Useful for capture, but scripts can become trapped in tooling.
        AppraiseJS keeps repo-owned files as the handoff.
      </p>
    </article>
    <article>
      <ShieldCheck aria-hidden="true" />
      <h3>TestRail and Gherkin</h3>
      <p>
        Strong planning and language layers. AppraiseJS connects authoring,
        locators, generated steps, and execution evidence.
      </p>
    </article>
  </div>

  <p class="known-boundaries">
    <Scale aria-hidden="true" />
    Best for browser workflow automation teams already using or evaluating Playwright.
    Not a hosted test-management replacement.
  </p>
</section>

<section
  class="docs-preview landing-shell"
  aria-labelledby="docs-preview-heading"
>
  <div class="docs-preview__copy">
    <p class="landing-kicker">Evaluate it</p>
    <h2 id="docs-preview-heading" class="landing-section-title">
      Evaluate it with one real smoke test.
    </h2>
  </div>
  <div class="docs-preview__grid">
    <a href="/getting-started/quick-start/">
      <BookOpen aria-hidden="true" />
      <span>Quick Start</span>
      <strong>Install, model, run, and inspect your first flow.</strong>
    </a>
    <a href="/build-tests/locators/">
      <ShieldCheck aria-hidden="true" />
      <span>Locator Builder</span>
      <strong>Create locator groups that survive UI changes.</strong>
    </a>
    <a href="/reference/architecture/execution-lifecycle/">
      <GitBranch aria-hidden="true" />
      <span>Execution Lifecycle</span>
      <strong>Understand generated files, runs, logs, and reports.</strong>
    </a>
  </div>
</section>

<section
  class="open-source landing-shell"
  aria-labelledby="open-source-heading"
>
  <div class="open-source__copy">
    <p class="landing-kicker">Open source</p>
    <h2 id="open-source-heading" class="landing-section-title">
      No vendor lock-in. No hidden runner. No black boxes.
    </h2>
    <p class="landing-section-description">
      AppraiseJS is built around local projects, pull requests, and automation
      artifacts that remain useful outside the visual editor.
    </p>
  </div>
  <div class="open-source__actions">
    <a class="landing-cta-button" href="/getting-started/quick-start/">
      Run the quick start locally
    </a>
    <a
      class="open-source__link"
      href="https://github.com/jamil2018/appraisejs-core"
      target="_blank"
      rel="noopener noreferrer"
    >
      <ExternalLink aria-hidden="true" />
      View GitHub Repository
    </a>
  </div>
</section>
