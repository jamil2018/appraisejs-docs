---
import {
  AlertTriangle,
  BookOpen,
  Code2,
  ExternalLink,
  FileCode2,
  GitBranch,
  GitPullRequestArrow,
  MonitorPlay,
  Scale,
  ShieldCheck,
  TerminalSquare,
} from "@lucide/astro";

const trustCards = [
  {
    icon: FileCode2,
    href: "/getting-started/creating-tests/",
    label: "Generated artifacts",
    description: "Review Gherkin, Playwright step code, and locator data.",
  },
  {
    icon: MonitorPlay,
    href: "/getting-started/running-tests/",
    label: "Local execution",
    description: "Run the smoke flow locally before carrying it into CI.",
  },
  {
    icon: GitBranch,
    href: "https://github.com/jamil2018/appraisejs-core",
    label: "Open source core",
    description: "Inspect the implementation before scaffolding a project.",
    external: true,
  },
];

const comparisonRows = [
  {
    icon: Code2,
    title: "Playwright alone",
    useCurrent:
      "Use it when engineers own all test authoring, locators, maintenance, and review.",
    useAppraise:
      "Use AppraiseJS when QA or SDET teams need visual authoring while engineers still review repo output.",
  },
  {
    icon: GitPullRequestArrow,
    title: "Cypress and recorders",
    useCurrent:
      "Use them when quick capture and a single-tool workflow are enough.",
    useAppraise:
      "Use AppraiseJS when generated Playwright/Cucumber files need to live in git instead of staying trapped in recorder state.",
  },
  {
    icon: ShieldCheck,
    title: "TestRail and Gherkin",
    useCurrent:
      "Use them when planning, traceability, and scenario language are the main need.",
    useAppraise:
      "Use AppraiseJS when authoring, locators, execution, and reports must stay connected.",
  },
  {
    icon: Scale,
    title: "Custom frameworks",
    useCurrent:
      "Use them when your team already has mature authoring, locator, CI, and reporting infrastructure.",
    useAppraise:
      "Use AppraiseJS when fragmentation across those pieces is the problem you are trying to reduce.",
  },
];

const notForYouItems = [
  "You want a hosted test-management suite to replace your existing planning tool.",
  "Your engineers prefer to hand-author every test and do not need visual collaboration.",
  "Your team is not willing to inspect generated code and own it in the repo.",
  "You need production usage metrics or customer logos before running a local evaluation.",
];

const evaluateSteps = [
  {
    icon: FileCode2,
    title: "Inspect generated sample",
    description:
      "Read the sample `.feature`, steps, locators, and report JSON above.",
    href: "#generated-output",
  },
  {
    icon: TerminalSquare,
    title: "Run `npx create-appraisejs@latest`",
    description:
      "Create the local project and confirm the generated files match the docs.",
    href: "/getting-started/quick-start/",
  },
  {
    icon: MonitorPlay,
    title: "Build one smoke flow",
    description:
      "Run it locally, inspect the report, and decide whether the handoff works.",
    href: "/getting-started/running-tests/",
  },
];
---

<section
  class="engineer-trust landing-shell"
  aria-labelledby="engineer-trust-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">What engineers keep</p>
    <h2 id="engineer-trust-heading" class="landing-section-title">
      Visual authoring without giving up the engineering loop.
    </h2>
    <p class="landing-section-description">
      AppraiseJS should fit a serious test stack: generated artifacts stay
      portable, execution stays local-first, and the evaluation path starts with
      one real smoke test.
    </p>
  </div>

  <div class="engineer-trust__grid">
    {
      trustCards.map((card) => {
        const Icon = card.icon;
        return (
          <a
            href={card.href}
            target={card.external ? "_blank" : undefined}
            rel={card.external ? "noopener noreferrer" : undefined}
          >
            <Icon aria-hidden="true" />
            <span>{card.label}</span>
            <strong>{card.description}</strong>
          </a>
        );
      })
    }
  </div>

  <div
    class="engineering-loop-strip"
    aria-label="Built for existing engineering loops"
  >
    <span>Local project</span>
    <span>Git-reviewed files</span>
    <span>CI-compatible runs</span>
    <span>Open source core</span>
  </div>
</section>

<section
  class="comparison-block landing-shell"
  aria-labelledby="comparison-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">Tradeoffs</p>
    <h2 id="comparison-heading" class="landing-section-title">
      Use AppraiseJS when visual authoring and repo-owned automation both
      matter.
    </h2>
    <p class="landing-section-description">
      It is not a replacement for every testing tool. It is a bridge for teams
      that need non-code authoring without losing Playwright, Cucumber, git
      review, and local execution.
    </p>
  </div>

  <div class="comparison-grid comparison-grid--tradeoffs">
    {
      comparisonRows.map((row) => {
        const Icon = row.icon;
        return (
          <article>
            <Icon aria-hidden="true" />
            <h3>{row.title}</h3>
            <p>
              <strong>Use the existing path:</strong> {row.useCurrent}
            </p>
            <p>
              <strong>Use AppraiseJS:</strong> {row.useAppraise}
            </p>
          </article>
        );
      })
    }
  </div>

  <aside class="known-boundaries known-boundaries--not-for-you">
    <AlertTriangle aria-hidden="true" />
    <div>
      <h3>Not for you if...</h3>
      <ul>
        {notForYouItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </aside>
</section>

<section
  class="docs-preview evaluate-path landing-shell"
  aria-labelledby="docs-preview-heading"
>
  <div class="docs-preview__copy">
    <p class="landing-kicker">Evaluate in 15 minutes</p>
    <h2 id="docs-preview-heading" class="landing-section-title">
      One sample, one scaffold, one smoke flow.
    </h2>
  </div>
  <div class="docs-preview__grid evaluate-path__grid">
    {
      evaluateSteps.map((step, index) => {
        const Icon = step.icon;
        return (
          <a href={step.href}>
            <Icon aria-hidden="true" />
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step.title}</strong>
            <p>{step.description}</p>
          </a>
        );
      })
    }
  </div>
</section>

<section
  class="open-source landing-shell"
  aria-labelledby="open-source-heading"
>
  <div class="open-source__copy">
    <p class="landing-kicker">Open source</p>
    <h2 id="open-source-heading" class="landing-section-title">
      No hidden runner. No generated-code black box.
    </h2>
    <p class="landing-section-description">
      AppraiseJS is built around local projects, pull requests, and automation
      artifacts that remain useful outside the visual editor.
    </p>
  </div>
  <div class="open-source__actions">
    <a class="landing-secondary-button" href="/getting-started/quick-start/">
      <BookOpen aria-hidden="true" />
      Run quick start locally
    </a>
    <a
      class="open-source__link"
      href="https://github.com/jamil2018/appraisejs-core"
      target="_blank"
      rel="noopener noreferrer"
    >
      <ExternalLink aria-hidden="true" />
      View GitHub Repository
    </a>
  </div>
</section>
