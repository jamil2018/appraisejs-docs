---
import {
  Check,
  Copy,
  ExternalLink,
  FileCode2,
  GitBranch,
  Timer,
} from "@lucide/astro";

const installCommand = "npx create-appraisejs@latest";
---

<section
  class="landing-hero landing-shell"
  aria-labelledby="landing-hero-heading"
>
  <div class="landing-hero__copy">
    <p class="landing-kicker">Open source visual test automation</p>
    <h1 id="landing-hero-heading">
      Build browser tests visually. Review real Playwright in git.
    </h1>
    <p class="landing-hero__description">
      AppraiseJS lets QA and SDET teams model browser flows visually, then
      generates Playwright/Cucumber artifacts engineers can review, run locally,
      and commit to CI.
    </p>
    <div class="landing-hero__actions">
      <a class="landing-cta-button" href="/getting-started/quick-start/">
        <Timer aria-hidden="true" />
        Generate a local Playwright flow
      </a>
      <a class="landing-secondary-button" href="#generated-output">
        <FileCode2 aria-hidden="true" />
        Inspect generated files
      </a>
      <a
        class="landing-tertiary-button"
        href="https://github.com/jamil2018/appraisejs-core"
        target="_blank"
        rel="noopener noreferrer"
      >
        <ExternalLink aria-hidden="true" />
        View GitHub
      </a>
    </div>
    <div class="landing-hero__install" aria-label="Install command">
      <pre
        class="landing-hero__command"><code data-hero-install-command><span class="token-key">npx</span><span class="token-command"> create-appraisejs@latest</span></code></pre>
      <button
        type="button"
        class="landing-hero__copy-button"
        data-hero-copy-command
        aria-label="Copy install command"
      >
        <Copy
          class="landing-hero__copy-icon"
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
        <Check
          class="landing-hero__copy-icon landing-hero__copy-icon--success"
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
      </button>
    </div>
    <p class="landing-hero__install-note">
      Creates a local sample project. No signup. Review the generated
      <code>.feature</code>, step code, locators, and report before adopting
      anything.
    </p>
    <div
      class="landing-hero__proof"
      aria-label="Generated files from the 15-minute result"
    >
      <div class="landing-hero__proof-step">
        <span class="landing-hero__proof-icon" aria-hidden="true">
          <FileCode2 />
        </span>
        <span>Scenario</span>
        <strong>.feature</strong>
      </div>
      <div class="landing-hero__proof-step">
        <span class="landing-hero__proof-icon" aria-hidden="true">
          <GitBranch />
        </span>
        <span>Step code</span>
        <strong>*.step.ts</strong>
      </div>
      <div class="landing-hero__proof-step">
        <span class="landing-hero__proof-icon" aria-hidden="true">
          <FileCode2 />
        </span>
        <span>Locators</span>
        <strong>locators.json</strong>
      </div>
      <div class="landing-hero__proof-step">
        <span class="landing-hero__proof-icon" aria-hidden="true">
          <Timer />
        </span>
        <span>Evidence</span>
        <strong>report.json</strong>
      </div>
    </div>
  </div>
</section>

<div class="mobile-sticky-cta" aria-label="Mobile quick actions">
  <a class="landing-cta-button" href="/getting-started/quick-start/">
    Run quick start
  </a>
  <a
    class="mobile-sticky-cta__github"
    href="https://github.com/jamil2018/appraisejs-core"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View GitHub repository"
  >
    <ExternalLink aria-hidden="true" />
  </a>
</div>

<script define:vars={{ installCommand }}>
  function initHeroCopy() {
    const button = document.querySelector("[data-hero-copy-command]");
    if (!button) return;

    let resetTimer;

    button.addEventListener("click", async () => {
      window.clearTimeout(resetTimer);

      try {
        await navigator.clipboard.writeText(installCommand);
      } catch {
        const code = document.querySelector("[data-hero-install-command]");
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        document.execCommand("copy");
        selection?.removeAllRanges();
      }

      button.classList.add("is-copied");
      button.setAttribute("aria-label", "Copied");

      resetTimer = window.setTimeout(() => {
        button.classList.remove("is-copied");
        button.setAttribute("aria-label", "Copy install command");
      }, 2000);
    });
  }

  document.addEventListener("astro:page-load", initHeroCopy);
  initHeroCopy();
</script>
