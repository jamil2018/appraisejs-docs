---
import {
  Check,
  Copy,
  ExternalLink,
  FileCode2,
  TerminalSquare,
} from "@lucide/astro";

const installCommand = "npx create-appraisejs@latest";
---

<section
  class="landing-hero landing-shell"
  aria-labelledby="landing-hero-heading"
>
  <div class="landing-hero__copy">
    <p class="landing-kicker">Open source visual test automation</p>
    <h1 id="landing-hero-heading">
      Deterministic visual test automation for everyone
    </h1>
    <p class="landing-hero__description">
      AppraiseJS is a visual test authoring platform that turns visually authored
      tests into reviewable artifacts such as: scenarios, step definitions,
      locator maps, and report evidence that your engineering team can inspect
      and version control.
    </p>
    <div class="landing-hero__actions">
      <a class="landing-cta-button" href="#generated-output">
        <FileCode2 aria-hidden="true" />
        Inspect generated output
      </a>
      <a class="landing-secondary-button" href="/getting-started/quick-start/">
        <TerminalSquare aria-hidden="true" />
        Run quick start locally
      </a>
      <a
        class="landing-tertiary-button"
        href="https://github.com/jamil2018/appraisejs-core"
        target="_blank"
        rel="noopener noreferrer"
      >
        <ExternalLink aria-hidden="true" />
        View GitHub
      </a>
    </div>
    <figure
      class="landing-hero__video-card"
      aria-label="Visual editor generating Playwright artifacts"
    >
      <div class="landing-panel__bar">
        <span>visual editor preview</span>
        <span>autoplay loop</span>
      </div>
      <video
        class="landing-hero__video"
        src="/landing/media/hero/hero-section-video.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        Your browser does not support embedded video.
      </video>
    </figure>
    <div class="landing-hero__install" aria-label="Install command">
      <pre
        class="landing-hero__command"><code data-hero-install-command><span class="token-key">npx</span><span class="token-command"> create-appraisejs@latest</span></code></pre>
      <button
        type="button"
        class="landing-hero__copy-button"
        data-hero-copy-command
        aria-label="Copy install command"
      >
        <Copy
          class="landing-hero__copy-icon"
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
        <Check
          class="landing-hero__copy-icon landing-hero__copy-icon--success"
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
      </button>
    </div>
  </div>
</section>

<script define:vars={{ installCommand }}>
  function initHeroCopy() {
    const button = document.querySelector("[data-hero-copy-command]");
    if (!button) return;

    let resetTimer;

    button.addEventListener("click", async () => {
      window.clearTimeout(resetTimer);

      try {
        await navigator.clipboard.writeText(installCommand);
      } catch {
        const code = document.querySelector("[data-hero-install-command]");
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        document.execCommand("copy");
        selection?.removeAllRanges();
      }

      button.classList.add("is-copied");
      button.setAttribute("aria-label", "Copied");

      resetTimer = window.setTimeout(() => {
        button.classList.remove("is-copied");
        button.setAttribute("aria-label", "Copy install command");
      }, 2000);
    });
  }

  document.addEventListener("astro:page-load", initHeroCopy);
  initHeroCopy();
</script>
