---
import {
  BookOpenCheck,
  FileCode2,
  FolderGit2,
  GitBranch,
  ServerOff,
  TerminalSquare,
} from "@lucide/astro";

const trustSignals = [
  {
    icon: GitBranch,
    label: "Open source core",
  },
  {
    icon: FolderGit2,
    label: "Local-first project",
  },
  {
    icon: FileCode2,
    label: "Playwright/Cucumber artifacts",
  },
  {
    icon: ServerOff,
    label: "No hosted runner required",
  },
  {
    icon: BookOpenCheck,
    label: "Architecture, sync, reports, and runtime docs",
  },
  {
    icon: TerminalSquare,
    label: "Runs from the generated repo",
  },
];
---

<section class="trust-signals landing-shell" aria-label="Trust signals">
  <div class="trust-signals__grid">
    {
      trustSignals.map((signal) => {
        const Icon = signal.icon;
        return (
          <div class="trust-signal">
            <Icon aria-hidden="true" />
            <span>{signal.label}</span>
          </div>
        );
      })
    }
  </div>
</section>
