---
import FlowBuilderGraph from "./FlowBuilderGraph.astro";
import LocatorCreatorDemo from "./LocatorCreatorDemo.astro";
import DynamicIntegratorDemo from "./DynamicIntegratorDemo.astro";
import PortableOutputDemo from "./PortableOutputDemo.astro";
import LocalFirstDemo from "./LocalFirstDemo.astro";
import AllInOneWorkspaceDemo from "./AllInOneWorkspaceDemo.astro";
import {
  Blocks,
  Check,
  ChevronDown,
  Code,
  Database,
  FileChartColumn,
  GitFork,
  KeyRound,
  MousePointerClick,
  Navigation,
  Play,
  Plus,
  ShieldCheck,
  Type,
  Wrench,
} from "@lucide/astro";

const features = [
  {
    id: "flow-builder",
    title: "Intuitive Test Flow Builder",
    description:
      "Author browser journeys as readable flow nodes before they become code.",
    icon: GitFork,
  },
  {
    id: "locator-creator",
    title: "Locator Creator",
    description:
      "Capture resilient selectors with role, label, and fallback context attached.",
    icon: ShieldCheck,
  },
  {
    id: "dynamic-node-builder",
    title: "Dynamic Node Builder",
    description:
      "Turn project-specific Playwright helpers into reusable visual actions.",
    icon: Blocks,
  },
  {
    id: "portable-output",
    title: "Portable Output",
    description:
      "Emit Playwright, Cucumber, support code, and evidence your team can review.",
    icon: Code,
  },
  {
    id: "local-first",
    title: "Local-First",
    description:
      "Run from developer machines and CI without routing through a hosted runner.",
    icon: Database,
  },
  {
    id: "all-in-one-workspace",
    title: "All In One Workspace",
    description:
      "Author, execute, and inspect results from one workspace instead of switching tools.",
    icon: Wrench,
  },
];
---

<section
  class="landing-features landing-shell"
  aria-labelledby="features-heading"
>
  <div class="landing-section-copy">
    <p class="landing-kicker">What is in AppraiseJS?</p>
    <h2 id="features-heading" class="landing-section-title">
      From visual intent to repo-owned automation.
    </h2>
    <p class="landing-section-description">
      Start with the workflow your team understands, enrich it with reliable
      locators and reusable steps, then ship generated files that stay useful
      outside the editor.
    </p>
  </div>

  <div class="feature-carousel not-content" data-feature-carousel>
    <div class="feature-carousel__rail" aria-label="Feature list">
      {
        features.map((feature, index) => (
          <a
            class:list={["feature-carousel__link", index === 0 && "is-active"]}
            href={`#feature-${feature.id}`}
            data-feature-link={feature.id}
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            {feature.title}
          </a>
        ))
      }
    </div>

    <div class="feature-carousel__track">
      {
        features.map((feature, index) => {
          const Icon = feature.icon;
          const isFlowBuilder = index === 0;
          const isLocatorCreator = index === 1;
          const isDynamicIntegrator = index === 2;
          const isPortableOutput = index === 3;
          const isLocalFirst = index === 4;
          const isAllInOneWorkspace = index === 5;
          const hasAnimation =
            isFlowBuilder ||
            isLocatorCreator ||
            isDynamicIntegrator ||
            isPortableOutput ||
            isLocalFirst ||
            isAllInOneWorkspace;
          return (
            <article
              id={`feature-${feature.id}`}
              class:list={[
                "feature-carousel__item",
                index === 0 && "is-active",
              ]}
              data-feature-panel={feature.id}
            >
              <div
                class:list={[
                  "feature-card",
                  hasAnimation && "feature-card--with-animation",
                  !hasAnimation && "feature-card--static",
                  isFlowBuilder && "feature-card--flow-builder",
                  isLocatorCreator && "feature-card--locator-creator",
                  isDynamicIntegrator && "feature-card--dynamic-integrator",
                  isPortableOutput && "feature-card--portable-output",
                  isLocalFirst && "feature-card--local-first",
                  isAllInOneWorkspace && "feature-card--all-in-one-workspace",
                ]}
              >
                {hasAnimation ? (
                  <div class="feature-card__desktop">
                    <div class="feature-card__desktop-bar" aria-hidden="true">
                      <span />
                      <span />
                      <span />
                    </div>
                    <div class="feature-card__animation">
                      {isFlowBuilder ? (
                        <FlowBuilderGraph fill />
                      ) : isLocatorCreator ? (
                        <LocatorCreatorDemo fill />
                      ) : isDynamicIntegrator ? (
                        <DynamicIntegratorDemo fill />
                      ) : isPortableOutput ? (
                        <PortableOutputDemo fill />
                      ) : isLocalFirst ? (
                        <LocalFirstDemo fill />
                      ) : (
                        <AllInOneWorkspaceDemo fill />
                      )}
                    </div>
                  </div>
                ) : (
                  <div class="feature-card__desktop feature-card__desktop--static">
                    <div class="feature-card__desktop-bar" aria-hidden="true">
                      <span />
                      <span />
                      <span />
                    </div>
                    <div class="feature-card__workspace">
                      <span class="feature-card__icon" aria-hidden="true">
                        <Icon />
                      </span>
                      <div class="feature-card__workspace-lines">
                        <span />
                        <span />
                        <span />
                      </div>
                    </div>
                  </div>
                )}
                <div class="feature-card__copy">
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const carousels = document.querySelectorAll("[data-feature-carousel]");

  carousels.forEach((carousel) => {
    const links = Array.from(carousel.querySelectorAll("[data-feature-link]"));
    const panels = Array.from(
      carousel.querySelectorAll("[data-feature-panel]"),
    );

    if (!("IntersectionObserver" in window) || panels.length === 0) return;

    const activate = (id: string) => {
      links.forEach((link) => {
        const isActive = link.getAttribute("data-feature-link") === id;
        link.classList.toggle("is-active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });

      panels.forEach((panel) => {
        panel.classList.toggle(
          "is-active",
          panel.getAttribute("data-feature-panel") === id,
        );
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!visible) return;

        const id = visible.target.getAttribute("data-feature-panel");
        if (id) activate(id);
      },
      {
        root: null,
        rootMargin: "-24% 0px -42% 0px",
        threshold: [0.2, 0.45, 0.7],
      },
    );

    panels.forEach((panel) => observer.observe(panel));
    activate(panels[0].getAttribute("data-feature-panel") || "");
  });
</script>

<section
  class="landing-showcase landing-showcase--wide landing-showcase--execution"
  aria-labelledby="workflow-heading"
  data-execution-scroll
>
  <div class="landing-shell landing-shell--wide">
    <div class="landing-section-copy">
      <p class="landing-kicker">Execution model</p>
      <h2 id="workflow-heading" class="landing-section-title">
        Build the workflow once. Emit real automation every time.
      </h2>
    </div>

    <div class="execution-model not-content" data-execution-model>
      <div class="execution-model__copy" aria-label="Execution model steps">
        <button
          class="execution-step is-active is-revealed"
          type="button"
          data-execution-step="create"
          data-execution-index="0"
        >
          <span class="execution-step__index">01</span>
          <span>
            <strong>Create</strong>
            <small>Author the login journey as connected browser actions.</small
            >
          </span>
        </button>
        <button
          class="execution-step"
          type="button"
          data-execution-step="configure"
          data-execution-index="1"
        >
          <span class="execution-step__index">02</span>
          <span>
            <strong>Configure</strong>
            <small
              >Add assertions from the page and attach them to the flow.</small
            >
          </span>
        </button>
        <button
          class="execution-step"
          type="button"
          data-execution-step="execute"
          data-execution-index="2"
        >
          <span class="execution-step__index">03</span>
          <span>
            <strong>Execute</strong>
            <small
              >Start a run, watch progress, and keep runtime context visible.</small
            >
          </span>
        </button>
        <button
          class="execution-step"
          type="button"
          data-execution-step="output"
          data-execution-index="3"
        >
          <span class="execution-step__index">04</span>
          <span>
            <strong>Generated Output</strong>
            <small
              >Review the report, trends, and evidence table in one place.</small
            >
          </span>
        </button>
      </div>

      <div class="execution-model__stage" aria-live="polite">
        <article
          class="execution-visual execution-visual--create is-active"
          data-execution-visual="create"
        >
          <div class="execution-window">
            <div class="execution-window__bar">
              <span>Create Test</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="execution-canvas">
              <div class="execution-node execution-node--navigate">
                <strong>Navigate</strong>
                <span><Navigation /></span>
              </div>
              <div class="execution-edge" aria-hidden="true"></div>
              <div class="execution-node execution-node--username">
                <strong>Fill Username</strong>
                <span><Type /></span>
              </div>
              <div class="execution-edge" aria-hidden="true"></div>
              <div class="execution-node execution-node--password">
                <strong>Fill Password</strong>
                <span><KeyRound /></span>
              </div>
              <div class="execution-edge" aria-hidden="true"></div>
              <div class="execution-node execution-node--click">
                <strong>Click Login</strong>
                <span><MousePointerClick /></span>
              </div>
            </div>
          </div>
        </article>

        <article
          class="execution-visual execution-visual--configure"
          data-execution-visual="configure"
        >
          <div class="execution-window">
            <div class="execution-window__bar">
              <span>Create Test</span>
              <button type="button" aria-label="Add test step"><Plus /></button>
            </div>
            <div class="execution-configure">
              <div class="execution-configure__canvas">
                <div class="execution-mini-node is-ready">
                  <strong>Navigate</strong>
                  <span><Navigation /></span>
                </div>
                <div class="execution-mini-edge" aria-hidden="true"></div>
                <div class="execution-mini-node is-ready">
                  <strong>Fill Username</strong>
                  <span><Type /></span>
                </div>
                <div class="execution-mini-edge" aria-hidden="true"></div>
                <div class="execution-mini-node is-ready">
                  <strong>Fill Password</strong>
                  <span><KeyRound /></span>
                </div>
                <div class="execution-mini-edge" aria-hidden="true"></div>
                <div class="execution-mini-node is-ready">
                  <strong>Click Login</strong>
                  <span><MousePointerClick /></span>
                </div>
                <div
                  class="execution-mini-edge execution-mini-edge--assert"
                  aria-hidden="true"
                >
                </div>
                <div class="execution-mini-node execution-mini-node--assert">
                  <strong>Assert Text</strong>
                  <span><Check /></span>
                </div>
              </div>
              <div class="execution-popover execution-popover--step">
                <div class="execution-popover__title">Add Node</div>
                <span></span>
                <span></span>
                <button type="button">
                  Assert Text
                  <ChevronDown />
                </button>
              </div>
              <div class="execution-popover execution-popover--picker">
                <div class="execution-popover__title">Extract Locator</div>
                <div class="execution-page-block"></div>
                <div class="execution-page-block is-selected"></div>
                <div class="execution-page-block"></div>
                <div class="execution-cursor"><MousePointerClick /></div>
              </div>
            </div>
          </div>
        </article>

        <article
          class="execution-visual execution-visual--execute"
          data-execution-visual="execute"
        >
          <div class="execution-window execution-window--run">
            <div class="execution-window__bar">
              <span>Create Test Run</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="execution-run-form">
              <span></span>
              <span></span>
              <span></span>
              <button type="button"><Play /> Start Test Run</button>
            </div>
          </div>
          <div class="execution-window execution-window--running">
            <div class="execution-window__bar">
              <span>Executing Tests</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="execution-progress">
              <span></span>
            </div>
            <div class="execution-run-fields">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </article>

        <article
          class="execution-visual execution-visual--output"
          data-execution-visual="output"
        >
          <div class="execution-window">
            <div class="execution-window__bar">
              <span>Test Report</span>
              <FileChartColumn />
            </div>
            <div class="execution-report">
              <div class="execution-report__summary">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="execution-report__graphs">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="execution-report__table">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  const executionModels = document.querySelectorAll("[data-execution-model]");

  executionModels.forEach((model) => {
    const section = model.closest("[data-execution-scroll]");
    const steps = Array.from(
      model.querySelectorAll("[data-execution-step]"),
    ) as HTMLButtonElement[];
    const visuals = Array.from(
      model.querySelectorAll("[data-execution-visual]"),
    );

    if (steps.length === 0 || visuals.length === 0) return;

    let activeIndex = -1;
    let animationFrame: number | undefined;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const activate = (index: number) => {
      if (
        index === activeIndex &&
        steps[index]?.classList.contains("is-active")
      ) {
        return;
      }

      activeIndex = index;
      const id = steps[index]?.getAttribute("data-execution-step");
      if (!id) return;

      steps.forEach((step, stepIndex) => {
        const isActive = step.getAttribute("data-execution-step") === id;
        step.classList.toggle("is-active", isActive);
        step.classList.toggle("is-revealed", stepIndex <= index);
        step.setAttribute("aria-pressed", String(isActive));
      });

      visuals.forEach((visual) => {
        visual.classList.toggle(
          "is-active",
          visual.getAttribute("data-execution-visual") === id,
        );
      });
    };

    const updateFromScroll = () => {
      animationFrame = undefined;

      if (!section || prefersReducedMotion) return;

      const rect = section.getBoundingClientRect();
      const range = Math.max(1, rect.height - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / range));
      const thresholds = [0, 0.16, 0.42, 0.69];
      const index = thresholds.reduce((current, threshold, thresholdIndex) => {
        return progress >= threshold ? thresholdIndex : current;
      }, 0);

      activate(index);
    };

    const requestScrollUpdate = () => {
      if (animationFrame || prefersReducedMotion) return;
      animationFrame = window.requestAnimationFrame(updateFromScroll);
    };

    steps.forEach((step, index) => {
      step.addEventListener("click", () => {
        activate(index);
        if (!section || prefersReducedMotion) return;

        const sectionTop = section.getBoundingClientRect().top + window.scrollY;
        const range = Math.max(1, section.clientHeight - window.innerHeight);
        const target =
          sectionTop + range * ((index + 0.5) / Math.max(1, steps.length));

        window.scrollTo({ top: target, behavior: "smooth" });
      });
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) {
          requestScrollUpdate();
        } else {
          if (animationFrame) {
            window.cancelAnimationFrame(animationFrame);
            animationFrame = undefined;
          }
        }
      },
      { threshold: 0.35 },
    );

    window.addEventListener("scroll", requestScrollUpdate, { passive: true });
    window.addEventListener("resize", requestScrollUpdate);
    activate(0);
    if (prefersReducedMotion) {
      steps.forEach((step) => step.classList.add("is-revealed"));
    }
    observer.observe(model);
    requestScrollUpdate();
    document.addEventListener(
      "astro:before-swap",
      () => {
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        window.removeEventListener("scroll", requestScrollUpdate);
        window.removeEventListener("resize", requestScrollUpdate);
      },
      { once: true },
    );
  });
</script>
