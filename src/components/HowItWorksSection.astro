---
import { Crosshair, FileCode2, TerminalSquare } from "@lucide/astro";
import LocatorCreatorDemo from "./LocatorCreatorDemo.astro";
import PortableOutputDemo from "./PortableOutputDemo.astro";
import LocalFirstDemo from "./LocalFirstDemo.astro";

const workflowSteps = [
  {
    id: "design",
    index: "01",
    title: "Design flows on a live app",
    description:
      "Point, click, and map locators from your running application. Build assertions and steps in a visual flow builder—no hand-written selectors required.",
    icon: Crosshair,
  },
  {
    id: "generate",
    index: "02",
    title: "Generate standard artifacts",
    description:
      "AppraiseJS exports Gherkin feature files, Playwright step definitions, and locator JSON into your repository. Every file is plain text you can diff and review.",
    icon: FileCode2,
  },
  {
    id: "run",
    index: "03",
    title: "Run locally, ship through CI",
    description:
      "Execute tests on your machine with zero cloud latency. The same artifacts run in any pipeline—no proprietary runners or hosted lock-in.",
    icon: TerminalSquare,
  },
];
---

<section
  class="how-it-works landing-shell"
  id="how-it-works"
  aria-labelledby="how-it-works-heading"
>
  <div class="landing-section-copy landing-section-copy--center">
    <p class="landing-kicker">How it works</p>
    <h2 id="how-it-works-heading" class="landing-section-title">
      From visual design to reviewable code in three steps.
    </h2>
    <p class="landing-section-description">
      A visual IDE built for the modern testing loop. No black boxes, no lock-in.
    </p>
  </div>

  <div class="how-it-works__steps-list not-content">
    {
      workflowSteps.map((step, index) => {
        const Icon = step.icon;
        const isEven = index % 2 === 1;
        return (
          <div class:list={["how-it-works__row", isEven && "how-it-works__row--reverse"]}>
            <div class="how-it-works__content">
              <span class="how-it-works__badge">Step {step.index}</span>
              <h3 class="how-it-works__step-title">
                <span class="how-it-works__icon-wrap" aria-hidden="true">
                  <Icon size={20} stroke-width={1.8} />
                </span>
                {step.title}
              </h3>
              <p class="how-it-works__step-desc">{step.description}</p>
            </div>
            <div class="how-it-works__visual-container">
              <div class="how-it-works__window">
                <div class="how-it-works__window-header" aria-hidden="true">
                  <span class="how-it-works__window-dot"></span>
                  <span class="how-it-works__window-dot"></span>
                  <span class="how-it-works__window-dot"></span>
                  <span class="how-it-works__window-title">{step.id}.appraise</span>
                </div>
                <div class="how-it-works__window-body">
                  {step.id === "design" && <LocatorCreatorDemo fill={true} />}
                  {step.id === "generate" && <PortableOutputDemo fill={true} />}
                  {step.id === "run" && <LocalFirstDemo fill={true} />}
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .how-it-works {
    padding-block: var(--landing-section-gap);
  }

  .how-it-works__steps-list {
    display: grid;
    gap: clamp(4rem, 8vw, 8rem);
    margin-top: 3.5rem;
  }

  .how-it-works__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .how-it-works__row {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .how-it-works__row--reverse {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .how-it-works__row--reverse .how-it-works__content {
      order: 2;
    }

    .how-it-works__row--reverse .how-it-works__visual-container {
      order: 1;
    }
  }

  .how-it-works__content {
    display: grid;
    gap: 1rem;
    max-width: 32rem;
  }

  .how-it-works__badge {
    display: inline-flex;
    align-items: center;
    width: max-content;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.06);
    color: var(--landing-green);
    font-family: var(--landing-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .how-it-works__step-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--landing-text);
  }

  .how-it-works__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--landing-border);
    border-radius: var(--landing-radius);
    background: #101010;
    color: var(--landing-green);
    flex-shrink: 0;
  }

  .how-it-works__step-desc {
    color: var(--landing-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .how-it-works__visual-container {
    width: 100%;
  }

  .how-it-works__window {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: clamp(20rem, 45vh, 28rem);
    border: 1px solid var(--landing-border);
    border-radius: var(--landing-radius);
    background: #101010;
    overflow: hidden;
    box-shadow: 
      0 20px 50px rgba(0, 0, 0, 0.3),
      inset 0 0 30px rgba(255, 255, 255, 0.01);
  }

  .how-it-works__window-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.5rem;
    padding-inline: 1rem;
    border-bottom: 1px solid var(--landing-border);
    background: rgba(255, 255, 255, 0.02);
  }

  .how-it-works__window-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
  }

  .how-it-works__window-title {
    margin-left: 0.75rem;
    color: var(--landing-dim);
    font-family: var(--landing-font-mono);
    font-size: 0.75rem;
  }

  .how-it-works__window-body {
    flex: 1;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    min-height: 0;
  }

  .how-it-works__window-body :global(.locator-creator-demo--fill),
  .how-it-works__window-body :global(.portable-output-demo--fill),
  .how-it-works__window-body :global(.local-first-demo--fill) {
    display: flex;
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .how-it-works__window-body :global(.locator-creator-demo--fill .locator-creator-demo__panel),
  .how-it-works__window-body :global(.portable-output-demo--fill .portable-output-demo__panel) {
    width: 100%;
    max-width: none;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .how-it-works__window-body :global(.local-first-demo--fill .local-first-demo__stage),
  .how-it-works__window-body :global(.portable-output-demo--fill .portable-output-demo__stage) {
    width: 100%;
    max-width: none;
    height: 100%;
    min-height: 0;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .how-it-works__layout {
      grid-template-columns: 1fr;
    }

    .how-it-works__stage {
      min-height: clamp(18rem, 40vh, 24rem);
    }
  }
</style>
