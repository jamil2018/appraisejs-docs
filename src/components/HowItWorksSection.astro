---
import { Crosshair, FileCode2, TerminalSquare } from "@lucide/astro";
import LocatorCreatorDemo from "./LocatorCreatorDemo.astro";
import PortableOutputDemo from "./PortableOutputDemo.astro";
import LocalFirstDemo from "./LocalFirstDemo.astro";

const workflowSteps = [
  {
    id: "design",
    index: "01",
    title: "Design flows on a live app",
    description:
      "Point, click, and map locators from your running application. Build assertions and steps in a visual flow builder—no hand-written selectors required.",
    icon: Crosshair,
    demo: "locator",
  },
  {
    id: "generate",
    index: "02",
    title: "Generate standard artifacts",
    description:
      "AppraiseJS exports Gherkin feature files, Playwright step definitions, and locator JSON into your repository. Every file is plain text you can diff and review.",
    icon: FileCode2,
    demo: "output",
  },
  {
    id: "run",
    index: "03",
    title: "Run locally, ship through CI",
    description:
      "Execute tests on your machine with zero cloud latency. The same artifacts run in any pipeline—no proprietary runners or hosted lock-in.",
    icon: TerminalSquare,
    demo: "local",
  },
];
---

<section
  class="how-it-works landing-shell"
  id="how-it-works"
  aria-labelledby="how-it-works-heading"
>
  <div class="landing-section-copy landing-section-copy--center">
    <p class="landing-kicker">How it works</p>
    <h2 id="how-it-works-heading" class="landing-section-title">
      From visual design to reviewable code in three steps.
    </h2>
    <p class="landing-section-description">
      Click through each step to preview the workflow inside the visual editor.
    </p>
  </div>

  <div class="how-it-works__layout not-content" data-how-it-works>
    <div class="how-it-works__steps" role="tablist" aria-label="Workflow steps">
      {
        workflowSteps.map((step, index) => {
          const Icon = step.icon;
          return (
            <button
              id={`how-it-works-tab-${step.id}`}
              type="button"
              role="tab"
              class:list={["how-it-works__step", index === 0 && "is-active"]}
              data-how-it-works-tab={step.id}
              aria-controls={`how-it-works-panel-${step.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
            >
              <span class="how-it-works__step-index" aria-hidden="true">
                {step.index}
              </span>
              <span class="how-it-works__step-icon" aria-hidden="true">
                <Icon size={18} stroke-width={1.8} />
              </span>
              <span class="how-it-works__step-copy">
                <strong>{step.title}</strong>
                <span>{step.description}</span>
              </span>
            </button>
          );
        })
      }
    </div>

    <div class="how-it-works__stage">
      <div
        id="how-it-works-panel-design"
        class="how-it-works__panel is-active"
        data-how-it-works-panel="design"
        role="tabpanel"
        aria-labelledby="how-it-works-tab-design"
      >
        <LocatorCreatorDemo fill={true} />
      </div>
      <div
        id="how-it-works-panel-generate"
        class="how-it-works__panel"
        data-how-it-works-panel="generate"
        role="tabpanel"
        aria-labelledby="how-it-works-tab-generate"
        hidden
      >
        <PortableOutputDemo fill={true} />
      </div>
      <div
        id="how-it-works-panel-run"
        class="how-it-works__panel"
        data-how-it-works-panel="run"
        role="tabpanel"
        aria-labelledby="how-it-works-tab-run"
        hidden
      >
        <LocalFirstDemo fill={true} />
      </div>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding-block: var(--landing-section-gap);
  }

  .how-it-works__layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    margin-top: 2rem;
  }

  .how-it-works__steps {
    display: grid;
    gap: 0.65rem;
  }

  .how-it-works__step {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 1rem 1.1rem;
    border: 1px solid var(--landing-border-soft);
    border-radius: var(--landing-radius);
    background: rgba(19, 19, 19, 0.5);
    color: var(--landing-muted);
    text-align: left;
    cursor: pointer;
    appearance: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .how-it-works__step:hover {
    border-color: rgba(255, 255, 255, 0.14);
    color: var(--landing-text);
  }

  .how-it-works__step.is-active {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.06);
    color: var(--landing-text);
  }

  .how-it-works__step-index {
    font-family: var(--landing-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--landing-dim);
    line-height: 1.5;
  }

  .how-it-works__step.is-active .how-it-works__step-index {
    color: var(--landing-green);
  }

  .how-it-works__step-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--landing-border);
    border-radius: var(--landing-radius);
    background: #101010;
    color: var(--landing-dim);
  }

  .how-it-works__step.is-active .how-it-works__step-icon {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.1);
    color: var(--landing-green);
  }

  .how-it-works__step-copy {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .how-it-works__step-copy strong {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    color: inherit;
  }

  .how-it-works__step-copy span {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--landing-dim);
  }

  .how-it-works__step.is-active .how-it-works__step-copy span {
    color: var(--landing-muted);
  }

  .how-it-works__stage {
    position: relative;
    min-height: clamp(22rem, 48vh, 30rem);
    border: 1px solid var(--landing-border);
    border-radius: var(--landing-radius);
    background: #101010;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .how-it-works__panel {
    display: none;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  .how-it-works__panel.is-active {
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }

  .how-it-works__panel:not(.is-active) * {
    animation-play-state: paused !important;
  }

  .how-it-works__panel :global(.locator-creator-demo--fill),
  .how-it-works__panel :global(.portable-output-demo--fill),
  .how-it-works__panel :global(.local-first-demo--fill) {
    display: flex;
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .how-it-works__panel :global(.locator-creator-demo--fill .locator-creator-demo__panel),
  .how-it-works__panel :global(.portable-output-demo--fill .portable-output-demo__panel) {
    width: 100%;
    max-width: none;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .how-it-works__panel :global(.local-first-demo--fill .local-first-demo__stage),
  .how-it-works__panel :global(.portable-output-demo--fill .portable-output-demo__stage) {
    width: 100%;
    max-width: none;
    height: 100%;
    min-height: 0;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .how-it-works__layout {
      grid-template-columns: 1fr;
    }

    .how-it-works__stage {
      min-height: clamp(18rem, 40vh, 24rem);
    }
  }
</style>

<script>
  function initHowItWorks() {
    const containers = document.querySelectorAll("[data-how-it-works]");

    containers.forEach((container) => {
      const tabs = Array.from(
        container.querySelectorAll("[data-how-it-works-tab]"),
      ) as HTMLElement[];
      const panels = Array.from(
        container.querySelectorAll("[data-how-it-works-panel]"),
      ) as HTMLElement[];

      if (tabs.length === 0 || panels.length === 0) return;

      const activate = (id: string) => {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.howItWorksTab === id;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
          tab.setAttribute("tabindex", isActive ? "0" : "-1");
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.howItWorksPanel === id;
          panel.classList.toggle("is-active", isActive);
          if (isActive) {
            panel.removeAttribute("hidden");
          } else {
            panel.setAttribute("hidden", "");
          }
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          const id = tab.dataset.howItWorksTab;
          if (id) activate(id);
        });

        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
          event.preventDefault();
          const direction = event.key === "ArrowDown" ? 1 : -1;
          const nextTab = tabs[(index + direction + tabs.length) % tabs.length];
          nextTab?.focus();
          const id = nextTab?.dataset.howItWorksTab;
          if (id) activate(id);
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initHowItWorks);
  initHowItWorks();
</script>
