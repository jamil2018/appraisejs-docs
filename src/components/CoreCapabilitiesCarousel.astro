---
import {
  ArrowRight,
  BarChart3,
  Blocks,
  Crosshair,
  Eye,
  Layers,
  LayoutTemplate,
  Rocket,
  Server,
  Workflow,
} from "@lucide/astro";

const features = [
  {
    title: "Visual Test Modeling",
    description:
      "Model test flows in a visual node-based builder that is easy to understand, compose, and reuse across scenarios.",
    href: "/getting-started/creating-tests/",
    Icon: Workflow,
  },
  {
    title: "Test Templating",
    description:
      "Create reusable templates for common workflows so teams can assemble new test coverage faster.",
    href: "/build-tests/template-test-cases/",
    Icon: LayoutTemplate,
  },
  {
    title: "Reusable Selector System",
    description:
      "Resolve locators by page route and hand the exact selector to the executor when a test needs it.",
    href: "/build-tests/locators/",
    Icon: Crosshair,
  },
  {
    title: "Custom Test Node Generation",
    description:
      "Define custom workflow nodes with the template step builder when the built-in node set does not match your test model.",
    href: "/build-tests/template-steps/",
    Icon: Blocks,
  },
  {
    title: "Environment Aware Execution",
    description:
      "Keep environment data centralized and available to the test runner without loading config in every test.",
    href: "/build-tests/environments/",
    Icon: Server,
  },
  {
    title: "Multi Config Test Orchestration",
    description:
      "Run tests by tag, suite, individual scenario, environment, and execution surface from one test run setup.",
    href: "/getting-started/running-tests/",
    Icon: Layers,
  },
  {
    title: "Test Run Management",
    description:
      "Create test runs with selected scenarios, environments, execution surfaces, workers, and run settings.",
    href: "/run-and-analyze/test-runs/",
    Icon: Rocket,
  },
  {
    title: "Runtime Visibility",
    description:
      "Follow live run logs, open artifacts, and inspect traces for failures from the same execution view.",
    href: "/getting-started/running-tests/",
    Icon: Eye,
  },
  {
    title: "Reporting",
    description:
      "Review execution metrics, result summaries, and trends through focused reports with charts and data cards.",
    href: "/run-and-analyze/reports/",
    Icon: BarChart3,
  },
] as const;
---

<section class="capability-deck" aria-label="Core capabilities">
  {
    features.map(({ title, description, href, Icon }, i) => (
      <article class="capability-card">
        <div class="capability-card__header">
          <span class="capability-card__number" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="capability-card__icon" aria-hidden="true">
            <Icon size={22} stroke-width={1.8} />
          </span>
        </div>
        <h3 class="capability-card__title">{title}</h3>
        <p class="capability-card__description">{description}</p>
        <a class="capability-card__link" href={href}>
          Learn more
          <ArrowRight size={15} stroke-width={2} aria-hidden="true" />
        </a>
      </article>
    ))
  }
</section>

<style>
  .capability-deck {
    --deck-border: hsl(var(--border));
    --deck-card: hsl(var(--card));
    --deck-muted: hsl(var(--muted-foreground));
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr));
    gap: 0.85rem;
    margin-block: 1.25rem 1.5rem;
  }

  .capability-card {
    margin: 0;
    min-block-size: 13.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--deck-border);
    border-radius: 0.5rem;
    background:
      linear-gradient(135deg, hsl(var(--primary) / 0.08), transparent 42%),
      var(--deck-card);
    box-shadow:
      0 1px 2px hsl(var(--foreground) / 0.04),
      0 8px 24px hsl(var(--foreground) / 0.05);
  }

  .capability-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .capability-card__number {
    color: var(--deck-muted);
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .capability-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
  }

  :global(.capability-card__icon svg) {
    display: block;
  }

  .capability-card__title {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: 1.02rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .capability-card__description {
    margin: 0;
    color: var(--deck-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .capability-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-block-start: auto;
    color: hsl(var(--primary));
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
  }

  .capability-card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .capability-card__link:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }

  :global(.capability-card__link svg) {
    display: block;
    flex-shrink: 0;
  }

  @media (max-width: 520px) {
    .capability-deck {
      grid-template-columns: minmax(0, 1fr);
    }

    .capability-card {
      min-block-size: auto;
    }
  }
</style>
