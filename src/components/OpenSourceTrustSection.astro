---
import { BookOpen, ExternalLink, Github } from "@lucide/astro";
---

<section
  class="open-source-trust landing-shell"
  aria-labelledby="open-source-trust-heading"
>
  <div class="open-source-trust__glow" aria-hidden="true"></div>
  
  <div class="open-source-trust__card">
    <div class="open-source-trust__content">
      <p class="landing-kicker">100% Open Source</p>
      <h2 id="open-source-trust-heading" class="open-source-trust__title">
        No hidden runners. No black boxes.
      </h2>
      <p class="open-source-trust__description">
        AppraiseJS is built entirely on open-source standards. Your tests, your locators, and your execution reports are plain files that live directly in your git repository. Run them locally, inspect them in PRs, and execute them in any CI pipeline without paying a single cent for proprietary runners.
      </p>
      
      <div class="open-source-trust__actions">
        <a
          class="landing-cta-button"
          href="https://github.com/jamil2018/appraisejs-core"
          target="_blank"
          rel="noopener noreferrer"
        >
          <ExternalLink size={16} />
          View on GitHub
        </a>
        <a class="landing-secondary-button" href="/core-concepts/architecture-overview/">
          <BookOpen size={16} />
          Read the Architecture
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .open-source-trust {
    position: relative;
    padding-top: clamp(4rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
    overflow: visible;
  }

  .open-source-trust__glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 30%);
    width: min(100vw, 800px);
    height: min(100vw, 800px);
    background: radial-gradient(
      circle,
      rgba(16, 185, 129, 0.06) 0%,
      rgba(59, 130, 246, 0.03) 45%,
      transparent 70%
    );
    filter: blur(60px);
    pointer-events: none;
    z-index: 1;
  }

  .open-source-trust__card {
    position: relative;
    z-index: 2;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--landing-border);
    border-radius: var(--landing-radius);
    background: 
      linear-gradient(135deg, rgba(16, 185, 129, 0.04) 0%, transparent 50%),
      rgba(19, 19, 19, 0.8);
    backdrop-filter: blur(12px);
    box-shadow: 
      0 20px 50px rgba(0, 0, 0, 0.3),
      inset 0 0 30px rgba(255, 255, 255, 0.01);
    overflow: hidden;
  }

  .open-source-trust__content {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }

  .open-source-trust__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--landing-text);
  }

  .open-source-trust__description {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.65;
    color: var(--landing-muted);
  }

  .open-source-trust__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    width: 100%;
  }

  @media (max-width: 640px) {
    .open-source-trust__actions > a {
      width: 100%;
    }
  }
</style>
