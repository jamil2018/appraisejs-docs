  }

  function getDialogLabel(image) {
    const alt = image.alt.trim();
    return alt ? `Expanded image: ${alt}` : "Expanded documentation image";
  }

  function ensureDialog() {
    const state = getState();
    if (state.elements) {
      return state.elements;
